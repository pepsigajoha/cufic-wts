# 이 파일을 .env로 복사하고 값을 채운다. .env는 커밋되지 않는다.
#
# 값은 Supabase 대시보드에서:
#   Project Settings → API → Project URL / Project API keys(anon public)

# 브라우저에 노출되는 값이다. 원래 공개 전제이며 비밀이 아니다.
# 실제 보안은 RLS 정책과 RPC 내부 검증이 담당한다.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 관리자 화면(/admin) 비밀번호. 코드에 하드코딩하지 않는다.
VITE_ADMIN_PASSWORD=change-me

# 주가 생성기의 "✨ AI 속보 재생성"은 Gemini API 키를 여기(.env)에 안 둔다 — VITE_ 접두사는
# 브라우저 번들에 그대로 노출되고, anon key와 달리 이 키는 뒤에 RLS 같은 서버측 방어막이
# 없다. 대신 Supabase Edge Function(supabase/functions/generate-breaking-news)의
# 서버측 secret으로만 설정한다:
#   supabase secrets set GEMINI_API_KEY=xxxxx
# 설정 안 해도(또는 Edge Function 미배포 상태여도) 기능은 자동으로 규칙 기반 생성기
# (src/admin/macroNews.js)로 대체되며 멈추지 않는다.

# ── 아래는 CLI 전용. 브라우저 번들에 들어가지 않는다(VITE_ 접두사 없음).
# supabase link / db push 에 필요하며 진짜 비밀이다.
#   access token: 대시보드 → Account → Access Tokens
#   db password : 프로젝트 생성 시 정한 비밀번호
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=
